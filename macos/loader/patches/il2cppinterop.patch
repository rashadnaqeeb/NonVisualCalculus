@@ -0,0 +1,54 @@
+using System;
+using System.Linq;
+using System.Runtime.InteropServices;
+using Il2CppInterop.Common;
+using Il2CppInterop.Common.XrefScans;
+using Il2CppInterop.Runtime.Runtime;
+using Microsoft.Extensions.Logging;
+
+namespace Il2CppInterop.Runtime.Injection.Hooks
+{
+    /// <summary>
+    ///     arm64 counterpart of <see cref="MetadataCache_GetTypeInfoFromTypeDefinitionIndex_Hook" /> for metadata
+    ///     v24.2 to v28. clang inlines GetTypeInfoFromTypeDefinitionIndex into Image::GetType, which then tail-calls
+    ///     MetadataCache::GetTypeInfoFromHandle with the type definition pointer. The injected class token arrives
+    ///     as that pointer, so the detour takes a pointer: an int parameter would leave the upper half of x0
+    ///     undefined when calling the original.
+    /// </summary>
+    internal unsafe class MetadataCache_GetTypeInfoFromHandle_Hook :
+        Hook<MetadataCache_GetTypeInfoFromHandle_Hook.MethodDelegate>
+    {
+        public override string TargetMethodName => "MetadataCache::GetTypeInfoFromHandle";
+        public override MethodDelegate GetDetour() => Hook;
+
+        [UnmanagedFunctionPointer(CallingConvention.Cdecl)]
+        internal delegate Il2CppClass* MethodDelegate(IntPtr handle);
+
+        private Il2CppClass* Hook(IntPtr handle)
+        {
+            if (InjectorHelpers.s_InjectedClasses.TryGetValue((long)handle, out IntPtr classPtr))
+                return (Il2CppClass*)classPtr;
+
+            return Original(handle);
+        }
+
+        /// <summary>Image::GetType, when it inlines the index-to-handle step and tail-calls the handle lookup.</summary>
+        public static bool TryFindImageGetTypeWithInlinedIndex(out IntPtr imageGetType)
+        {
+            var imageGetClassAPI = InjectorHelpers.GetIl2CppExport(nameof(IL2CPP.il2cpp_image_get_class));
+            imageGetType = XrefScannerLowLevel.JumpTargets(imageGetClassAPI).First();
+            Logger.Instance.LogTrace("Image::GetType: 0x{ImageGetTypeAddress}", imageGetType.ToInt64().ToString("X2"));
+
+            var tailCalls = XrefScannerLowLevel.JumpTargets(imageGetType).Distinct().ToArray();
+            return tailCalls.Length == 1 && Arm64Code.ContainsMultiplyAdd64(imageGetType);
+        }
+
+        public override IntPtr FindTargetMethod()
+        {
+            if (!TryFindImageGetTypeWithInlinedIndex(out var imageGetType))
+                return IntPtr.Zero;
+
+            return XrefScannerLowLevel.JumpTargets(imageGetType).First();
+        }
+    }
+}
diff --git a/Il2CppInterop.Runtime/Injection/Il2CppModuleInfo.cs b/Il2CppInterop.Runtime/Injection/Il2CppModuleInfo.cs
