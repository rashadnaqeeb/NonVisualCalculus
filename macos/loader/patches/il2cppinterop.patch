new file mode 100644
index 0000000..7ca07ce
--- /dev/null
+++ b/Il2CppInterop.Common/XrefScans/Arm64Code.cs
@@ -0,0 +1,296 @@
+using System.Collections.Concurrent;
+using System.Runtime.InteropServices;
+
+namespace Il2CppInterop.Common.XrefScans;
+
+/// <summary>
+///     AArch64 counterparts of the x86 decoding the injector relies on, plus Mach-O image lookups for arm64 macOS,
+///     where <see cref="System.Diagnostics.Process.Modules" /> lists only the main executable.
+/// </summary>
+public static unsafe class Arm64Code
+{
+    private const uint MovzW1Imm1 = 0x52800021; // mov w1, #1
+
+    private static readonly ConcurrentDictionary<long, ulong[]> FunctionStartsByImage = new();
+
+    public static bool IsArm64 => RuntimeInformation.ProcessArchitecture == Architecture.Arm64;
+
+    public static bool IsBranch(uint instruction) => (instruction & 0xFC000000) == 0x14000000;
+    public static bool IsBranchLink(uint instruction) => (instruction & 0xFC000000) == 0x94000000;
+    public static bool IsReturn(uint instruction) => (instruction & 0xFFFFFC1F) == 0xD65F0000;
+
+    public static bool IsOtherFlowControl(uint instruction) =>
+        (instruction & 0xFF000010) == 0x54000000 || // b.cond
+        (instruction & 0x7E000000) == 0x34000000 || // cbz, cbnz
+        (instruction & 0x7E000000) == 0x36000000 || // tbz, tbnz
+        (instruction & 0xFFFFFC1F) == 0xD61F0000 || // br
+        (instruction & 0xFFFFFC1F) == 0xD63F0000;   // blr
+
+    /// <summary>smaddl/umaddl/madd (64-bit): the index-to-pointer arithmetic of an inlined metadata lookup.</summary>
+    public static bool IsMultiplyAdd64(uint instruction) =>
+        (instruction & 0xFFE08000) == 0x9B200000 ||
+        (instruction & 0xFFE08000) == 0x9BA00000 ||
+        (instruction & 0xFFE08000) == 0x9B000000;
+
+    // Iterators cannot hold unsafe code.
+    private static uint Read(IntPtr address) => (uint)Marshal.ReadInt32(address);
+
+    public static IntPtr BranchTarget(IntPtr pc, uint instruction)
+    {
+        var imm26 = (int)(instruction << 6) >> 6;
+        return (IntPtr)((long)pc + ((long)imm26 << 2));
+    }
+
+    /// <summary>
+    ///     Follows <c>b imm26</c> thunks, the shape of many exported il2cpp API functions on arm64.
+    /// </summary>
+    public static IntPtr FollowBranchThunks(IntPtr function)
+    {
+        for (var hops = 0; hops < 8 && function != IntPtr.Zero; hops++)
+        {
+            var instruction = *(uint*)function;
+            if (!IsBranch(instruction))
+                break;
+            function = BranchTarget(function, instruction);
+        }
+
+        return function;
+    }
+
+    /// <summary>
+    ///     Mirrors the x86 <c>XrefScannerLowLevel.JumpTargets</c>: call targets and unconditional branches that
+    ///     leave the function, stopping at the first return unless <paramref name="ignoreRetn" />, and stopping
+    ///     after an unconditional branch that is the first control flow (a thunk). The scan is bounded by the
+    ///     function's end, which on macOS comes from the image's LC_FUNCTION_STARTS.
+    /// </summary>
+    public static IEnumerable<IntPtr> JumpTargets(IntPtr codeStart, bool ignoreRetn)
+    {
+        var (functionStart, functionEnd) = FunctionBounds(codeStart);
+        var firstFlowControl = true;
+
+        for (var pc = codeStart; (long)pc < (long)functionEnd; pc += 4)
+        {
+            var instruction = Read(pc);
+
+            if (IsReturn(instruction))
+            {
+                if (!ignoreRetn)
+                    yield break;
+                firstFlowControl = false;
+                continue;
+            }
+
+            if (IsBranchLink(instruction))
+            {
+                yield return BranchTarget(pc, instruction);
+                firstFlowControl = false;
+                continue;
+            }
+
+            if (IsBranch(instruction))
+            {
+                var target = BranchTarget(pc, instruction);
+                var leavesFunction = (long)target < (long)functionStart || (long)target >= (long)functionEnd;
+                if (leavesFunction)
+                {
+                    yield return target;
+                    if (firstFlowControl)
+                        yield break;
+                }
+
+                firstFlowControl = false;
+                continue;
+            }
+
+            if (IsOtherFlowControl(instruction))
+                firstFlowControl = false;
+        }
+    }
+
+    /// <summary>Call sites (bl) in the function containing <paramref name="codeStart" />, from it to the function end.</summary>
+    public static IEnumerable<(IntPtr site, IntPtr target)> CallSites(IntPtr codeStart)
+    {
+        var (_, functionEnd) = FunctionBounds(codeStart);
+        for (var pc = codeStart; (long)pc < (long)functionEnd; pc += 4)
+        {
+            var instruction = Read(pc);
+            if (IsBranchLink(instruction))
+                yield return (pc, BranchTarget(pc, instruction));
+        }
+    }
+
+    /// <summary>The last <c>bl</c> in the function whose preceding instruction is <c>mov w1, #1</c>.</summary>
+    public static IntPtr LastCallWithSecondArgumentOne(IntPtr function)
+    {
+        var result = IntPtr.Zero;
+        foreach (var (site, target) in CallSites(function))
+            if (Read(site - 4) == MovzW1Imm1)
+                result = target;
+        return result;
+    }
+
+    public static bool ContainsMultiplyAdd64(IntPtr function)
+    {
+        var (_, functionEnd) = FunctionBounds(function);
+        for (var pc = function; (long)pc < (long)functionEnd; pc += 4)
+            if (IsMultiplyAdd64(Read(pc)))
+                return true;
+        return false;
+    }
+
+    /// <summary>
+    ///     The start and end of the function containing <paramref name="address" />. Without function starts
+    ///     (non-Mach-O), the end is a fixed window past the address.
+    /// </summary>
+    public static (IntPtr start, IntPtr end) FunctionBounds(IntPtr address)
+    {
+        if (!RuntimeInformation.IsOSPlatform(OSPlatform.OSX) || !TryGetImage(address, out var header, out _))
+            return (address, address + 4096);
+
+        var starts = FunctionStartsByImage.GetOrAdd((long)header, h => ReadFunctionStarts((IntPtr)h));
+        var offset = (ulong)((long)address - (long)header);
+        var index = Array.BinarySearch(starts, offset);
+        if (index < 0)
+            index = ~index - 1;
+        if (index < 0 || index + 1 >= starts.Length)
+            return (address, address + 4096);
+
+        return ((IntPtr)((long)header + (long)starts[index]), (IntPtr)((long)header + (long)starts[index + 1]));
+    }
+
+    /// <summary>The Mach-O header and path of the loaded image containing <paramref name="address" />.</summary>
+    public static bool TryGetImage(IntPtr address, out IntPtr header, out string path)
+    {
+        DlInfo info;
+        if (dladdr(address, &info) == 0 || info.dli_fbase == IntPtr.Zero)
+        {
+            header = IntPtr.Zero;
+            path = null;
+            return false;
+        }
+
+        header = info.dli_fbase;
+        path = Marshal.PtrToStringAnsi(info.dli_fname);
+        return true;
+    }
+
+    /// <summary>Size of a loaded 64-bit Mach-O image in memory: the span of its segments, __PAGEZERO excluded.</summary>
+    public static long ImageSize(IntPtr header)
+    {
+        var textVmAddr = ulong.MaxValue;
+        ulong end = 0;
+        foreach (var segment in Segments(header))
+        {
+            if (segment.name == "__PAGEZERO")
+                continue;
+            textVmAddr = Math.Min(textVmAddr, segment.vmaddr);
+            end = Math.Max(end, segment.vmaddr + segment.vmsize);
+        }
+
+        return (long)(end - textVmAddr);
+    }
+
+    private const uint MhMagic64 = 0xFEEDFACF;
+    private const uint LcSegment64 = 0x19;
+    private const uint LcFunctionStarts = 0x26;
+
+    private static IEnumerable<(string name, ulong vmaddr, ulong vmsize, ulong fileoff)> Segments(IntPtr header)
+    {
+        var list = new List<(string, ulong, ulong, ulong)>();
+        if (*(uint*)header != MhMagic64)
+            throw new NotSupportedException($"Not a 64-bit Mach-O image at 0x{(long)header:X}");
+
+        var ncmds = *(uint*)(header + 16);
+        var command = header + 32;
+        for (var i = 0; i < ncmds; i++)
+        {
+            var cmd = *(uint*)command;
+            var cmdsize = *(uint*)(command + 4);
+            if (cmd == LcSegment64)
+            {
+                var name = Marshal.PtrToStringAnsi(command + 8, 16).TrimEnd('\0');
+                list.Add((name, *(ulong*)(command + 24), *(ulong*)(command + 32), *(ulong*)(command + 40)));
+            }
+
+            command += (int)cmdsize;
+        }
+
+        return list;
+    }
+
+    /// <summary>Function start offsets from the image header, ascending, decoded from LC_FUNCTION_STARTS.</summary>
+    private static ulong[] ReadFunctionStarts(IntPtr header)
+    {
+        ulong textVmAddr = 0, linkeditVmAddr = 0, linkeditFileOff = 0;
+        var haveText = false;
+        var haveLinkedit = false;
+        foreach (var segment in Segments(header))
+        {
+            if (segment.name == "__TEXT")
+            {
+                textVmAddr = segment.vmaddr;
+                haveText = true;
+            }
+            else if (segment.name == "__LINKEDIT")
+            {
+                linkeditVmAddr = segment.vmaddr;
+                linkeditFileOff = segment.fileoff;
+                haveLinkedit = true;
+            }
+        }
+
+        uint dataOff = 0, dataSize = 0;
+        var ncmds = *(uint*)(header + 16);
+        var command = header + 32;
+        for (var i = 0; i < ncmds; i++)
+        {
+            if (*(uint*)command == LcFunctionStarts)
+            {
+                dataOff = *(uint*)(command + 8);
+                dataSize = *(uint*)(command + 12);
+            }
+
+            command += (int)*(uint*)(command + 4);
+        }
+
+        if (!haveText || !haveLinkedit || dataSize == 0)
+            throw new NotSupportedException($"Mach-O image at 0x{(long)header:X} has no LC_FUNCTION_STARTS");
+
+        var slide = (long)header - (long)textVmAddr;
+        var data = (byte*)(slide + (long)linkeditVmAddr + (long)(dataOff - linkeditFileOff));
+        var starts = new List<ulong>();
+        ulong current = 0;
+        for (long position = 0; position < dataSize;)
+        {
+            ulong delta = 0;
+            var shift = 0;
+            byte b;
+            do
+            {
+                b = data[position++];
+                delta |= (ulong)(b & 0x7F) << shift;
+                shift += 7;
+            } while ((b & 0x80) != 0);
+
+            if (delta == 0)
+                break;
+            current += delta;
+            starts.Add(current);
+        }
+
+        // Image-relative offsets are measured from __TEXT, which starts at the header.
+        return starts.ToArray();
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct DlInfo
+    {
+        public IntPtr dli_fname;
+        public IntPtr dli_fbase;
+        public IntPtr dli_sname;
+        public IntPtr dli_saddr;
+    }
+
+    [DllImport("libSystem.dylib")]
+    private static extern int dladdr(IntPtr address, DlInfo* info);
+}
