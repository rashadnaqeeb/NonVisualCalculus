#!/bin/sh
# The app bundle Steam's launch option points at (see run-modded.sh, "--open"): Steam spawns a
# script launch option as x86_64, which needs Rosetta, but opens a bundle through LaunchServices
# natively. It runs the script beside the bundle and nothing else.
a="/$0"; a=${a%/*}; a=${a#/}; a=${a:-.}; here=$(cd "$a" || exit 1; pwd -P)
exec "$here/../../../run-modded.sh" --open "$@"
